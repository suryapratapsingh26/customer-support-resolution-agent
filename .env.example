# Copy to .env. Generate every value marked REPLACE with an independent random secret.
# Never use these placeholders in a deployed environment.

# Runtime: use development for local HTTP; staging/production require HTTPS OIDC,
# secure cookies, HTTPS trusted origins, and every server-side credential below.
ENVIRONMENT=development

# Compose PostgreSQL. Set a unique strong password before starting containers.
POSTGRES_DB=customer_support
POSTGRES_USER=postgres
# Bootstrap superuser; only used by the database container's first initialization.
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DB_USER=support_app
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
MIGRATION_DB_USER=support_migrator
MIGRATION_DB_PASSWORD=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
DASHBOARD_PORT=8080

# Local Compose overrides DATABASE_URL to reach the db service. For host-run API use localhost.
DATABASE_URL=postgresql+psycopg://support_app:REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS@localhost:5432/customer_support

# OIDC authorization code client. Configure a real provider and register this exact callback.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/api/bff/auth/callback
OIDC_JWKS_URL=
# Leave empty for standard provider discovery. Local Keycloak profile uses a private
# backchannel URL from .env.keycloak.example; it is development-only.
OIDC_BACKCHANNEL_BASE_URL=
OIDC_ALLOWED_ALGORITHMS=["RS256"]
OIDC_ROLES_CLAIM=roles
OIDC_CUSTOMER_IDS_CLAIM=customer_ids
OIDC_REVIEWER_ROLE=support_reviewer
OIDC_AGENT_ROLE=support_agent

# Browser session and CSRF. Set secure=true and HTTPS origins in non-development environments.
BFF_SESSION_COOKIE_NAME=support_session
BFF_SESSION_TTL_SECONDS=28800
BFF_SESSION_COOKIE_SECURE=false
BFF_TRUSTED_ORIGINS=["http://localhost:8080"]

# Independent high-entropy server-to-server credentials (minimum 32 characters).
BACKEND_SERVICE_API_KEY=REPLACE_WITH_RANDOM_BACKEND_SERVICE_KEY
AGENT_API_KEY=REPLACE_WITH_RANDOM_AGENT_SERVICE_KEY
AGENT_CUSTOMER_TOKEN_SECRET=REPLACE_WITH_RANDOM_CUSTOMER_SCOPE_SIGNING_SECRET
APPROVAL_API_KEY=REPLACE_WITH_RANDOM_REFUND_REVIEWER_KEY
APPROVAL_ACTOR_ID=REPLACE_WITH_REVIEWER_SERVICE_ID
APPROVAL_REQUEST_API_KEY=REPLACE_WITH_RANDOM_REFUND_REQUESTER_KEY
APPROVAL_REQUEST_ACTOR_ID=REPLACE_WITH_REQUESTER_SERVICE_ID

# Optional LLM provider. Agent recommendations require a configured compatible API.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# Retrieval and local vector index.
KNOWLEDGE_BASE_DIR=knowledge_base
CHROMA_PERSIST_DIR=.data/chroma
CHROMA_COLLECTION_NAME=support_knowledge
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_TOP_K=5
KNOWLEDGE_CONTEXT_MAX_CHARS=12000
