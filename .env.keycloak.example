# LOCAL DEVELOPMENT ONLY. Copy to .env.keycloak; never use these values in deployment.
# This file is read only when you explicitly enable the local-oidc Compose profile.

# Browser-facing Keycloak endpoint and backend-only Docker-network backchannel.
KEYCLOAK_PORT=8081
OIDC_ISSUER_BASE_URL=http://localhost:8081
OIDC_ISSUER=http://localhost:8081/realms/customer-support-dev
OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080
OIDC_AUDIENCE=support-dashboard
OIDC_CLIENT_ID=support-dashboard
OIDC_CLIENT_SECRET=local-only-dashboard-client-secret
OIDC_REDIRECT_URI=http://localhost:8080/api/bff/auth/callback
OIDC_JWKS_URL=
OIDC_ALLOWED_ALGORITHMS=["RS256"]
OIDC_ROLES_CLAIM=roles
OIDC_CUSTOMER_IDS_CLAIM=customer_ids
OIDC_REVIEWER_ROLE=support_reviewer
OIDC_AGENT_ROLE=support_agent

# Bootstrap and demo-user passwords. These have no production use.
KC_BOOTSTRAP_ADMIN_USERNAME=local-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=local-only-keycloak-admin-password
OIDC_DEV_AGENT_PASSWORD=local-only-agent-password
OIDC_DEV_REVIEWER_PASSWORD=local-only-reviewer-password

# Must match the IDs in the local application database. The startup script rejects zero/non-integer values.
OIDC_DEV_CUSTOMER_IDS=1,2,3
